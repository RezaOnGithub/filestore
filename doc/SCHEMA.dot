// Filestore conceptual schema, DESIGN.md section 13.
// Generated from the section 13 table listings; edit freely.
// Render with: dot -Tsvg doc/SCHEMA.dot -o SCHEMA.svg (the output is not kept in the repository)

digraph filestore_schema {
  graph [
    rankdir=LR,
    bgcolor="#F8FAFC",
    pad="0.4",
    nodesep="0.35",
    ranksep="1.1",
    splines=spline,
    outputorder=edgesfirst,
    fontname="Helvetica",
    labelloc=t,
    labeljust=l,
    label=<<FONT POINT-SIZE="24"><B>Filestore conceptual schema</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#475569">DESIGN.md §13 · conceptual, not final DDL · arrows point from referencing column to referenced row · dashed = logical reference without FK · <FONT COLOR="#94A3B8">?</FONT> nullable · witness ledger (§10.1) omitted: application layer, not core catalog</FONT><BR/><FONT POINT-SIZE="11"><FONT COLOR="#1E40AF"><B>■</B> §13.1 root configuration and scanning</FONT>   <FONT COLOR="#0F766E"><B>■</B> §13.2 observations and enumeration</FONT>   <FONT COLOR="#15803D"><B>■</B> §13.3 file reads, Blobs, baselines</FONT>   <FONT COLOR="#B45309"><B>■</B> §13.4 extractors, derived metadata, manifests · §13.5 action provenance</FONT>   <FONT COLOR="#7C3AED"><B>■</B> §13.6 semantic identities and changes</FONT></FONT><BR/> >
  ];

  node [shape=plain, fontname="Helvetica", fontsize=9];
  edge [color="#94A3B8", penwidth=1.0, arrowsize=0.6, arrowhead=vee];

  // §13.1 root configuration and scanning
  database_metadata [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#64748B" BGCOLOR="white">
    <TR><TD BGCOLOR="#1E40AF" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="12"><B>database_metadata</B></FONT><BR/><FONT COLOR="#DBEAFE" POINT-SIZE="8">§13.1 · singleton (id = 1)</FONT></TD></TR>
    <TR><TD PORT="id" ALIGN="LEFT" CELLPADDING="3"><B>id</B>  <FONT COLOR="#B45309">PK</FONT></TD></TR>
    <TR><TD PORT="schema_version" ALIGN="LEFT" CELLPADDING="3">schema_version</TD></TR>
    <TR><TD PORT="content_scheme_version" ALIGN="LEFT" CELLPADDING="3">content_scheme_version</TD></TR>
    <TR><TD PORT="created_at" ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR>
  </TABLE>>];

  roots [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#64748B" BGCOLOR="white">
    <TR><TD BGCOLOR="#1E40AF" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="12"><B>roots</B></FONT><BR/><FONT COLOR="#DBEAFE" POINT-SIZE="8">§13.1 · logical archive</FONT></TD></TR>
    <TR><TD PORT="id" ALIGN="LEFT" CELLPADDING="3"><B>id</B>  <FONT COLOR="#B45309">PK</FONT></TD></TR>
    <TR><TD PORT="public_id" ALIGN="LEFT" CELLPADDING="3">public_id  <FONT COLOR="#7C3AED">UQ</FONT></TD></TR>
    <TR><TD PORT="created_at" ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR>
  </TABLE>>];

  root_bindings [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#64748B" BGCOLOR="white">
    <TR><TD BGCOLOR="#1E40AF" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="12"><B>root_bindings</B></FONT><BR/><FONT COLOR="#DBEAFE" POINT-SIZE="8">§13.1 · immutable; candidate until activated</FONT></TD></TR>
    <TR><TD PORT="id" ALIGN="LEFT" CELLPADDING="3"><B>id</B>  <FONT COLOR="#B45309">PK</FONT></TD></TR>
    <TR><TD PORT="root_id" ALIGN="LEFT" CELLPADDING="3">root_id  <FONT COLOR="#2563EB">FK</FONT></TD></TR>
    <TR><TD PORT="root_relative_components" ALIGN="LEFT" CELLPADDING="3">root_relative_components</TD></TR>
