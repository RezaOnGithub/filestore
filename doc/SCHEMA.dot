    <TR><TD PORT="mode" ALIGN="LEFT" CELLPADDING="3">mode <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT> <FONT COLOR="#94A3B8">?</FONT></TD></TR>
    <TR><TD PORT="nlink" ALIGN="LEFT" CELLPADDING="3">nlink <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT> <FONT COLOR="#94A3B8">?</FONT></TD></TR>
    <TR><TD PORT="boundary" ALIGN="LEFT" CELLPADDING="3">boundary <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT></TD></TR>
