    <TR><TD PORT="size" ALIGN="LEFT" CELLPADDING="3">size <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT> <FONT COLOR="#94A3B8">?</FONT></TD></TR>
    <TR><TD PORT="mtime_ns" ALIGN="LEFT" CELLPADDING="3">mtime_ns <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT> <FONT COLOR="#94A3B8">?</FONT></TD></TR>
