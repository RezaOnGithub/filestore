    <TR><TD PORT="parent_obs_id" ALIGN="LEFT" CELLPADDING="3">parent_obs_id <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT> <FONT COLOR="#94A3B8">?</FONT>  <FONT COLOR="#2563EB">FK</FONT></TD></TR>
    <TR><TD PORT="role" ALIGN="LEFT" CELLPADDING="3">role <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT></TD></TR>
    <TR><TD PORT="enumeration_id" ALIGN="LEFT" CELLPADDING="3">enumeration_id <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT> <FONT COLOR="#94A3B8">?</FONT>  <FONT COLOR="#2563EB">FK</FONT></TD></TR>
