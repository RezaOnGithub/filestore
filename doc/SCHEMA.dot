// Filestore prototype schema: the tables of crates/filestore/src/schema.sql.
// Generated by doc/schema_dot.py; regenerate after schema changes instead of editing by hand.
// Render with: dot -Tsvg doc/SCHEMA.dot -o SCHEMA.svg (the output is not kept in the repository)

digraph filestore_schema {
  graph [
    rankdir=LR, bgcolor="#F8FAFC", pad="0.4", nodesep="0.35", ranksep="1.1",
    splines=spline, outputorder=edgesfirst, fontname="Helvetica", labelloc=t, labeljust=l,
    label=<<FONT POINT-SIZE="24"><B>Filestore prototype schema</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#475569">crates/filestore/src/schema.sql · SQLite STRICT tables · arrows point from referencing column to referenced row · dashed = logical reference without FK · <FONT COLOR="#94A3B8">?</FONT> nullable · triggers enforce closure and immutability of evidence (see the notes under each table)</FONT><BR/><FONT POINT-SIZE="11"><FONT COLOR="#1E40AF"><B>■</B> catalog, epochs, locations, scans</FONT>   <FONT COLOR="#0F766E"><B>■</B> observations and listings</FONT>   <FONT COLOR="#15803D"><B>■</B> reads, Blobs, baselines</FONT>   <FONT COLOR="#B45309"><B>■</B> derived metadata and command acceptance</FONT>   <FONT COLOR="#0E7490"><B>■</B> projection (rebuildable)</FONT>   <FONT COLOR="#7C3AED"><B>■</B> semantic records</FONT></FONT><BR/> >
  ];

  node [shape=plain, fontname="Helvetica", fontsize=9];
  edge [color="#94A3B8", penwidth=1.0, arrowsize=0.6, arrowhead=vee, fontname="Helvetica"];

  // catalog, epochs, locations, scans
  meta [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#64748B" BGCOLOR="white">
    <TR><TD BGCOLOR="#1E40AF" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="12"><B>meta</B></FONT><BR/><FONT COLOR="#DBEAFE" POINT-SIZE="8">key/value: schema version, root path, settings</FONT></TD></TR>
    <TR><TD PORT="key" ALIGN="LEFT" CELLPADDING="3"><B>key</B> <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT>  <FONT COLOR="#B45309">PK</FONT></TD></TR>
    <TR><TD PORT="value" ALIGN="LEFT" CELLPADDING="3">value <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT></TD></TR>
  </TABLE>>];
  epochs [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#64748B" BGCOLOR="white">
    <TR><TD BGCOLOR="#1E40AF" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="12"><B>epochs</B></FONT><BR/><FONT COLOR="#DBEAFE" POINT-SIZE="8">immutable · active epoch = latest row</FONT></TD></TR>
    <TR><TD PORT="id" ALIGN="LEFT" CELLPADDING="3"><B>id</B> <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT>  <FONT COLOR="#B45309">PK</FONT></TD></TR>
    <TR><TD PORT="public_id" ALIGN="LEFT" CELLPADDING="3">public_id <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT>  <FONT COLOR="#7C3AED">UQ</FONT></TD></TR>
    <TR><TD PORT="fs_context" ALIGN="LEFT" CELLPADDING="3">fs_context <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT></TD></TR>
    <TR><TD PORT="root_ino" ALIGN="LEFT" CELLPADDING="3">root_ino <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT></TD></TR>
    <TR><TD PORT="reason" ALIGN="LEFT" CELLPADDING="3">reason <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT></TD></TR>
    <TR><TD PORT="created_at" ALIGN="LEFT" CELLPADDING="3">created_at <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT></TD></TR>
  </TABLE>>];
  locations [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#64748B" BGCOLOR="white">
    <TR><TD BGCOLOR="#1E40AF" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="12"><B>locations</B></FONT><BR/><FONT COLOR="#DBEAFE" POINT-SIZE="8">immutable · interned root-relative byte paths</FONT></TD></TR>
    <TR><TD PORT="id" ALIGN="LEFT" CELLPADDING="3"><B>id</B> <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT>  <FONT COLOR="#B45309">PK</FONT></TD></TR>
    <TR><TD PORT="parent_id" ALIGN="LEFT" CELLPADDING="3">parent_id <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT> <FONT COLOR="#94A3B8">?</FONT>  <FONT COLOR="#2563EB">FK</FONT></TD></TR>
    <TR><TD PORT="name" ALIGN="LEFT" CELLPADDING="3">name <FONT COLOR="#94A3B8" POINT-SIZE="8">blob</FONT></TD></TR>
    <TR><TD PORT="path" ALIGN="LEFT" CELLPADDING="3">path <FONT COLOR="#94A3B8" POINT-SIZE="8">blob</FONT>  <FONT COLOR="#7C3AED">UQ</FONT></TD></TR>
  </TABLE>>];
  scans [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#64748B" BGCOLOR="white">
    <TR><TD BGCOLOR="#1E40AF" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="12"><B>scans</B></FONT><BR/><FONT COLOR="#DBEAFE" POINT-SIZE="8">request + session · closed once; then immutable</FONT></TD></TR>
    <TR><TD PORT="id" ALIGN="LEFT" CELLPADDING="3"><B>id</B> <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT>  <FONT COLOR="#B45309">PK</FONT></TD></TR>
    <TR><TD PORT="public_id" ALIGN="LEFT" CELLPADDING="3">public_id <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT>  <FONT COLOR="#7C3AED">UQ</FONT></TD></TR>
    <TR><TD PORT="operation" ALIGN="LEFT" CELLPADDING="3">operation <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT></TD></TR>
    <TR><TD PORT="targets" ALIGN="LEFT" CELLPADDING="3">targets <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT></TD></TR>
    <TR><TD PORT="requested_at" ALIGN="LEFT" CELLPADDING="3">requested_at <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT></TD></TR>
    <TR><TD PORT="provenance_id" ALIGN="LEFT" CELLPADDING="3">provenance_id <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT> <FONT COLOR="#94A3B8">?</FONT>  <FONT COLOR="#2563EB">FK</FONT></TD></TR>
    <TR><TD PORT="state" ALIGN="LEFT" CELLPADDING="3">state <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT></TD></TR>
    <TR><TD PORT="epoch_id" ALIGN="LEFT" CELLPADDING="3">epoch_id <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT> <FONT COLOR="#94A3B8">?</FONT>  <FONT COLOR="#2563EB">FK</FONT></TD></TR>
    <TR><TD PORT="policy" ALIGN="LEFT" CELLPADDING="3">policy <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT> <FONT COLOR="#94A3B8">?</FONT></TD></TR>
    <TR><TD PORT="scanner_version" ALIGN="LEFT" CELLPADDING="3">scanner_version <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT> <FONT COLOR="#94A3B8">?</FONT></TD></TR>
    <TR><TD PORT="started_at" ALIGN="LEFT" CELLPADDING="3">started_at <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT> <FONT COLOR="#94A3B8">?</FONT></TD></TR>
    <TR><TD PORT="outcome" ALIGN="LEFT" CELLPADDING="3">outcome <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT> <FONT COLOR="#94A3B8">?</FONT></TD></TR>
    <TR><TD PORT="finished_at" ALIGN="LEFT" CELLPADDING="3">finished_at <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT> <FONT COLOR="#94A3B8">?</FONT></TD></TR>
    <TR><TD PORT="summary" ALIGN="LEFT" CELLPADDING="3">summary <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT> <FONT COLOR="#94A3B8">?</FONT></TD></TR>
    <TR><TD PORT="error" ALIGN="LEFT" CELLPADDING="3">error <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT> <FONT COLOR="#94A3B8">?</FONT></TD></TR>
    <TR><TD PORT="publication_seq" ALIGN="LEFT" CELLPADDING="3">publication_seq <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT> <FONT COLOR="#94A3B8">?</FONT>  <FONT COLOR="#7C3AED">UQ</FONT></TD></TR>
  </TABLE>>];
  diagnostics [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#64748B" BGCOLOR="white">
    <TR><TD BGCOLOR="#1E40AF" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="12"><B>diagnostics</B></FONT><BR/><FONT COLOR="#DBEAFE" POINT-SIZE="8">append-only while the scan runs</FONT></TD></TR>
    <TR><TD PORT="id" ALIGN="LEFT" CELLPADDING="3"><B>id</B> <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT>  <FONT COLOR="#B45309">PK</FONT></TD></TR>
    <TR><TD PORT="scan_id" ALIGN="LEFT" CELLPADDING="3">scan_id <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT>  <FONT COLOR="#2563EB">FK</FONT></TD></TR>
    <TR><TD PORT="location_id" ALIGN="LEFT" CELLPADDING="3">location_id <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT> <FONT COLOR="#94A3B8">?</FONT>  <FONT COLOR="#2563EB">FK</FONT></TD></TR>
    <TR><TD PORT="severity" ALIGN="LEFT" CELLPADDING="3">severity <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT></TD></TR>
    <TR><TD PORT="code" ALIGN="LEFT" CELLPADDING="3">code <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT></TD></TR>
    <TR><TD PORT="message" ALIGN="LEFT" CELLPADDING="3">message <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT></TD></TR>
    <TR><TD PORT="at" ALIGN="LEFT" CELLPADDING="3">at <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT></TD></TR>
    <TR><TD PORT="event_order" ALIGN="LEFT" CELLPADDING="3">event_order <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT></TD></TR>
  </TABLE>>];

  // observations and listings
  observations [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#64748B" BGCOLOR="white">
    <TR><TD BGCOLOR="#0F766E" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="12"><B>observations</B></FONT><BR/><FONT COLOR="#CCFBF1" POINT-SIZE="8">append-only while the scan runs</FONT></TD></TR>
    <TR><TD PORT="id" ALIGN="LEFT" CELLPADDING="3"><B>id</B> <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT>  <FONT COLOR="#B45309">PK</FONT></TD></TR>
    <TR><TD PORT="scan_id" ALIGN="LEFT" CELLPADDING="3">scan_id <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT>  <FONT COLOR="#2563EB">FK</FONT></TD></TR>
