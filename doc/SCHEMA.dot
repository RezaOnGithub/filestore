    <TR><TD PORT="id" ALIGN="LEFT" CELLPADDING="3"><B>id</B> <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT>  <FONT COLOR="#B45309">PK</FONT></TD></TR>
