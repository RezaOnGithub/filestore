    <TR><TD PORT="previous_activation_id" ALIGN="LEFT" CELLPADDING="3">previous_activation_id <FONT COLOR="#94A3B8">?</FONT>  <FONT COLOR="#7C3AED">UQ</FONT> <FONT COLOR="#2563EB">FK</FONT></TD></TR>
    <TR><TD PORT="identity_epoch_id" ALIGN="LEFT" CELLPADDING="3">identity_epoch_id  <FONT COLOR="#2563EB">FK</FONT></TD></TR>
    <TR><TD PORT="reason" ALIGN="LEFT" CELLPADDING="3">reason</TD></TR>
    <TR><TD PORT="reference_view" ALIGN="LEFT" CELLPADDING="3">reference_view <FONT COLOR="#94A3B8">?</FONT></TD></TR>
    <TR><TD PORT="comparison_publication_sequence" ALIGN="LEFT" CELLPADDING="3">comparison_publication_sequence <FONT COLOR="#94A3B8">?</FONT>  <FONT COLOR="#64748B">ref</FONT></TD></TR>
    <TR><TD PORT="comparison_report" ALIGN="LEFT" CELLPADDING="3">comparison_report <FONT COLOR="#94A3B8">?</FONT></TD></TR>
    <TR><TD PORT="created_at" ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR>
  </TABLE>>];

