    <TR><TD PORT="id" ALIGN="LEFT" CELLPADDING="3"><B>id</B> <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT>  <FONT COLOR="#B45309">PK</FONT></TD></TR>
    <TR><TD PORT="public_id" ALIGN="LEFT" CELLPADDING="3">public_id <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT>  <FONT COLOR="#7C3AED">UQ</FONT></TD></TR>
    <TR><TD PORT="hierarchy_id" ALIGN="LEFT" CELLPADDING="3">hierarchy_id <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT>  <FONT COLOR="#2563EB">FK</FONT></TD></TR>
    <TR><TD PORT="parent_id" ALIGN="LEFT" CELLPADDING="3">parent_id <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT> <FONT COLOR="#94A3B8">?</FONT>  <FONT COLOR="#2563EB">FK</FONT></TD></TR>
    <TR><TD PORT="name" ALIGN="LEFT" CELLPADDING="3">name <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT></TD></TR>
    <TR><TD PORT="created_at" ALIGN="LEFT" CELLPADDING="3">created_at <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT></TD></TR>
  </TABLE>>];
  tag_assignments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#64748B" BGCOLOR="white">
    <TR><TD BGCOLOR="#7C3AED" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="12"><B>tag_assignments</B></FONT><BR/><FONT COLOR="#EDE9FE" POINT-SIZE="8">one tag per target and hierarchy</FONT></TD></TR>
    <TR><TD PORT="target_kind" ALIGN="LEFT" CELLPADDING="3"><B>target_kind</B> <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT>  <FONT COLOR="#B45309">PK</FONT></TD></TR>
    <TR><TD PORT="target_id" ALIGN="LEFT" CELLPADDING="3"><B>target_id</B> <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT>  <FONT COLOR="#B45309">PK</FONT></TD></TR>
    <TR><TD PORT="hierarchy_id" ALIGN="LEFT" CELLPADDING="3"><B>hierarchy_id</B> <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT>  <FONT COLOR="#B45309">PK</FONT> <FONT COLOR="#2563EB">FK</FONT></TD></TR>
    <TR><TD PORT="tag_id" ALIGN="LEFT" CELLPADDING="3">tag_id <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT>  <FONT COLOR="#2563EB">FK</FONT></TD></TR>
    <TR><TD PORT="assigned_at" ALIGN="LEFT" CELLPADDING="3">assigned_at <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT></TD></TR>
  </TABLE>>];
  lineages [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#64748B" BGCOLOR="white">
    <TR><TD BGCOLOR="#7C3AED" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="12"><B>lineages</B></FONT><BR/><FONT COLOR="#EDE9FE" POINT-SIZE="8">tombstoned, never deleted</FONT></TD></TR>
    <TR><TD PORT="id" ALIGN="LEFT" CELLPADDING="3"><B>id</B> <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT>  <FONT COLOR="#B45309">PK</FONT></TD></TR>
    <TR><TD PORT="public_id" ALIGN="LEFT" CELLPADDING="3">public_id <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT>  <FONT COLOR="#7C3AED">UQ</FONT></TD></TR>
    <TR><TD PORT="title" ALIGN="LEFT" CELLPADDING="3">title <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT></TD></TR>
    <TR><TD PORT="created_at" ALIGN="LEFT" CELLPADDING="3">created_at <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT></TD></TR>
    <TR><TD PORT="tombstoned_at" ALIGN="LEFT" CELLPADDING="3">tombstoned_at <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT> <FONT COLOR="#94A3B8">?</FONT></TD></TR>
  </TABLE>>];
  revisions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#64748B" BGCOLOR="white">
    <TR><TD BGCOLOR="#7C3AED" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="12"><B>revisions</B></FONT><BR/><FONT COLOR="#EDE9FE" POINT-SIZE="8">content identity immutable</FONT></TD></TR>
    <TR><TD PORT="id" ALIGN="LEFT" CELLPADDING="3"><B>id</B> <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT>  <FONT COLOR="#B45309">PK</FONT></TD></TR>
    <TR><TD PORT="public_id" ALIGN="LEFT" CELLPADDING="3">public_id <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT>  <FONT COLOR="#7C3AED">UQ</FONT></TD></TR>
    <TR><TD PORT="lineage_id" ALIGN="LEFT" CELLPADDING="3">lineage_id <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT>  <FONT COLOR="#2563EB">FK</FONT></TD></TR>
    <TR><TD PORT="blob_id" ALIGN="LEFT" CELLPADDING="3">blob_id <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT>  <FONT COLOR="#2563EB">FK</FONT></TD></TR>
    <TR><TD PORT="label" ALIGN="LEFT" CELLPADDING="3">label <FONT COLOR="#94A3B8" POINT-SIZE="8">text</FONT> <FONT COLOR="#94A3B8">?</FONT></TD></TR>
    <TR><TD PORT="created_at" ALIGN="LEFT" CELLPADDING="3">created_at <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT></TD></TR>
    <TR><TD PORT="tombstoned_at" ALIGN="LEFT" CELLPADDING="3">tombstoned_at <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT> <FONT COLOR="#94A3B8">?</FONT></TD></TR>
  </TABLE>>];
  revision_parents [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#64748B" BGCOLOR="white">
    <TR><TD BGCOLOR="#7C3AED" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="white" POINT-SIZE="12"><B>revision_parents</B></FONT><BR/><FONT COLOR="#EDE9FE" POINT-SIZE="8">DAG within one Lineage</FONT></TD></TR>
    <TR><TD PORT="revision_id" ALIGN="LEFT" CELLPADDING="3"><B>revision_id</B> <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT>  <FONT COLOR="#B45309">PK</FONT> <FONT COLOR="#2563EB">FK</FONT></TD></TR>
    <TR><TD PORT="parent_id" ALIGN="LEFT" CELLPADDING="3"><B>parent_id</B> <FONT COLOR="#94A3B8" POINT-SIZE="8">integer</FONT>  <FONT COLOR="#B45309">PK</FONT> <FONT COLOR="#2563EB">FK</FONT></TD></TR>
  </TABLE>>];

  // Foreign keys
  locations:parent_id -> locations:id [color="#1E40AF80"];
  scans:epoch_id -> epochs:id [color="#1E40AF80"];
  scans:provenance_id -> action_provenance:id [color="#1E40AF80"];
  diagnostics:location_id -> locations:id [color="#1E40AF80"];
  diagnostics:scan_id -> scans:id [color="#1E40AF80"];
  observations:enumeration_id -> enumerations:id [color="#0F766E80"];
  observations:parent_obs_id -> observations:id [color="#0F766E80"];
  observations:location_id -> locations:id [color="#0F766E80"];
  observations:scan_id -> scans:id [color="#0F766E80"];
  enumerations:dir_obs_id -> observations:id [color="#0F766E80"];
  enumerations:trigger_obs_id -> observations:id [color="#0F766E80"];
  enumerations:location_id -> locations:id [color="#0F766E80"];
  enumerations:scan_id -> scans:id [color="#0F766E80"];
  enumeration_results:enumeration_id -> enumerations:id [color="#0F766E80"];
  reads:policy_id -> sampling_policies:id [color="#15803D80"];
  reads:compared_blob_id -> blobs:id [color="#15803D80"];
  reads:opened_obs_id -> observations:id [color="#15803D80"];
  reads:trigger_obs_id -> observations:id [color="#15803D80"];
  reads:location_id -> locations:id [color="#15803D80"];
  reads:scan_id -> scans:id [color="#15803D80"];
  read_results:recognized_blob_id -> blobs:id [color="#15803D80"];
  read_results:read_id -> reads:id [color="#15803D80"];
  blobs:admitted_from_read_id -> reads:id [color="#15803D80"];
  baselines:created_from_read_id -> reads:id [color="#15803D80"];
  baselines:policy_id -> sampling_policies:id [color="#15803D80"];
  baselines:blob_id -> blobs:id [color="#15803D80"];
  derived_metadata:read_id -> reads:id [color="#B4530980"];
  derived_metadata:scan_id -> scans:id [color="#B4530980"];
  derived_metadata:blob_id -> blobs:id [color="#B4530980"];
  occurrences:verified_blob_id -> blobs:id [color="#0E749080"];
  occurrences:content_blob_id -> blobs:id [color="#0E749080"];
  occurrences:parent_occ_id -> occurrences:id [color="#0E749080"];
  occurrences:location_id -> locations:id [color="#0E749080"];
  occurrences:epoch_id -> epochs:id [color="#0E749080"];
  semantic_ops:provenance_id -> action_provenance:id [color="#7C3AED80"];
  tags:parent_id -> tags:id [color="#7C3AED80"];
  tags:hierarchy_id -> tag_hierarchies:id [color="#7C3AED80"];
  tag_assignments:tag_id -> tags:id [color="#7C3AED80"];
  tag_assignments:hierarchy_id -> tag_hierarchies:id [color="#7C3AED80"];
  revisions:blob_id -> blobs:id [color="#7C3AED80"];
  revisions:lineage_id -> lineages:id [color="#7C3AED80"];
  revision_parents:parent_id -> revisions:id [color="#7C3AED80"];
  revision_parents:revision_id -> revisions:id [color="#7C3AED80"];

  // Logical references
  occurrences:first_obs_id -> observations:id [color="#0E749080", style=dashed];
  occurrences:last_obs_id -> observations:id [color="#0E749080", style=dashed];
  occurrences:content_read_id -> reads:id [color="#0E749080", style=dashed];
  occurrences:verified_read_id -> reads:id [color="#0E749080", style=dashed];
  occurrences:check_read_id -> reads:id [color="#0E749080", style=dashed];
  occurrences:issue_read_id -> reads:id [color="#0E749080", style=dashed];
  occurrences:check_blob_id -> blobs:id [color="#0E749080", style=dashed];
  occurrences:prev_blob_id -> blobs:id [color="#0E749080", style=dashed];
  occurrences:listing_enum_id -> enumerations:id [color="#0E749080", style=dashed];
  tag_assignments:target_id -> blobs:id [color="#7C3AED80", style=dashed, label="target_kind = blob", fontsize=8, fontcolor="#64748B"];
  tag_assignments:target_id -> lineages:id [color="#7C3AED80", style=dashed, label="lineage", fontsize=8, fontcolor="#64748B"];
  tag_assignments:target_id -> revisions:id [color="#7C3AED80", style=dashed, label="revision", fontsize=8, fontcolor="#64748B"];
}
